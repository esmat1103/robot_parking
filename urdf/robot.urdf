<?xml version="1.0"?>
<!--
  robot.urdf : description du robot (la même pour RViz et Gazebo).

  Le robot réel : châssis 20 x 14 cm (roues comprises), roues de 65 mm.
  En simulation on le modélise en "différentiel" :
    2 roues motrices (gauche / droite) + 2 patins sans frottement (avant / arrière).
  Le vrai châssis 4 roues se pilote de la même façon : vitesse v + rotation w.

  Repères (frames) :
    base_footprint : le point au sol sous le centre du robot
    base_link      : le centre du robot, à hauteur des axes de roues
    laser          : le capteur de distance, à l'avant
-->
<robot name="robot_parking">

  <!-- ================= Couleurs (pour RViz) ================= -->
  <material name="bleu"><color rgba="0.1 0.3 0.8 1"/></material>
  <material name="noir"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="rouge"><color rgba="0.9 0.1 0.1 1"/></material>

  <!-- ================= Point au sol ================= -->
  <link name="base_footprint"/>

  <joint name="joint_base" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.0325"/>          <!-- rayon de roue = 32,5 mm -->
  </joint>

  <!-- ================= Châssis ================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.01"/>
      <geometry><box size="0.20 0.088 0.04"/></geometry>
      <material name="bleu"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01"/>
      <geometry><box size="0.20 0.088 0.04"/></geometry>
    </collision>
    <!-- patin avant et patin arrière (petites billes qui glissent) -->
    <collision>
      <origin xyz="0.075 0 -0.0205"/>
      <geometry><sphere radius="0.012"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.075 0 -0.0205"/>
      <geometry><sphere radius="0.012"/></geometry>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.00047" iyy="0.00208" izz="0.00239" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ================= Roue gauche ================= -->
  <link name="roue_gauche">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0325" length="0.026"/></geometry>
      <material name="noir"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0325" length="0.026"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.000016" iyy="0.000026" izz="0.000016" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint_roue_gauche" type="continuous">
    <parent link="base_link"/>
    <child link="roue_gauche"/>
    <origin xyz="0 0.057 0"/>           <!-- écart entre roues = 2 x 57 = 114 mm -->
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================= Roue droite ================= -->
  <link name="roue_droite">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0325" length="0.026"/></geometry>
      <material name="noir"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0325" length="0.026"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.000016" iyy="0.000026" izz="0.000016" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint_roue_droite" type="continuous">
    <parent link="base_link"/>
    <child link="roue_droite"/>
    <origin xyz="0 -0.057 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================= Capteur de distance (avant) ================= -->
  <link name="laser">
    <visual>
      <geometry><box size="0.02 0.04 0.015"/></geometry>
      <material name="rouge"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.09 0 0.04"/>
  </joint>

  <!-- ================= Caméra (avant, légèrement inclinée vers le bas) ================= -->
  <link name="camera">
    <visual>
      <geometry><box size="0.015 0.03 0.02"/></geometry>
      <material name="noir"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint_camera" type="fixed">
    <parent link="base_link"/>
    <child link="camera"/>
    <origin xyz="0.095 0 0.035" rpy="0 0.25 0"/>   <!-- 0,25 rad = 14° vers le bas -->
  </joint>

  <!-- ================= Réglages propres à Gazebo ================= -->

  <!-- frottements : roues qui adhèrent, châssis/patins qui glissent -->
  <gazebo reference="roue_gauche"><mu1>1.0</mu1><mu2>1.0</mu2><material>Gazebo/Black</material></gazebo>
  <gazebo reference="roue_droite"><mu1>1.0</mu1><mu2>1.0</mu2><material>Gazebo/Black</material></gazebo>
  <gazebo reference="base_link"><mu1>0.0</mu1><mu2>0.0</mu2><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="laser"><material>Gazebo/Red</material></gazebo>

  <!-- Moteurs : reçoit /cmd_vel (v, w), fait tourner les roues, publie /odom -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <left_joint>joint_roue_gauche</left_joint>
      <right_joint>joint_roue_droite</right_joint>
      <wheel_separation>0.114</wheel_separation>
      <wheel_diameter>0.065</wheel_diameter>
      <max_wheel_torque>0.5</max_wheel_torque>
      <max_wheel_acceleration>3.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <!-- 1 = position exacte donnée par Gazebo (pas d'erreur d'odométrie) -->
      <odometry_source>1</odometry_source>
      <update_rate>30</update_rate>
    </plugin>
  </gazebo>

  <!-- Capteur : 15 rayons sur 70° devant le robot, portée 2 cm à 1,2 m, publie /scan -->
  <gazebo reference="laser">
    <sensor name="capteur_distance" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>15</samples>
            <min_angle>-0.61</min_angle>
            <max_angle>0.61</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>1.2</max>
          <resolution>0.005</resolution>
        </range>
      </ray>
      <plugin name="plugin_scan" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Caméra : 640 x 480, champ de vision 60°, 15 images/s, publie /camera/image_raw -->
  <gazebo reference="camera">
    <material>Gazebo/Black</material>
    <sensor name="camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.01</near><far>5.0</far></clip>
      </camera>
      <plugin name="plugin_camera" filename="libgazebo_ros_camera.so">
        <camera_name>camera</camera_name>
        <frame_name>camera</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
